# Postgres connection string from Supabase (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Any password you want to log into the app with
APP_PASSWORD=changeme

# Random long random string, used to sign session cookies
SESSION_SECRET=change-this-to-something-random

# The ntfy.sh topic name you subscribed to in the ntfy iPhone app (pick something hard to guess)
NTFY_TOPIC=your-secret-topic-name-123

PORT=3000
