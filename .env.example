# Postgres connection string from Supabase (Project Settings -> Database -> Connection string).
# Supabase gives you three variants - which one to use depends on where this runs:
#   - Vercel (serverless, many concurrent short-lived invocations): use the
#     "Transaction" pooler, port 6543. This is REQUIRED on Vercel - the direct
#     or Session-pooler (port 5432) connection limit gets exhausted quickly
#     under serverless load.
#       DATABASE_URL=postgres://user:password@host.pooler.supabase.com:6543/postgres
#   - Local dev and the GitHub Actions tick script (scripts/tick.js): either
#     works, since these are single short-lived connections. Session pooler
#     (port 5432) shown below is fine here.
DATABASE_URL=postgres://user:password@host.pooler.supabase.com:5432/postgres

# Any password you want to log into the app with
APP_PASSWORD=changeme

# Random long random string, used to sign session cookies
SESSION_SECRET=change-this-to-something-random

# The ntfy.sh topic name you subscribed to in the ntfy iPhone app (pick something hard to guess)
NTFY_TOPIC=your-secret-topic-name-123

PORT=3000
