# Postgres connection string from Supabase (Project Settings -> Database -> Connection string).
# Supabase gives you three variants - which one to use depends on where this runs:
#   - Vercel (serverless, many concurrent short-lived invocations): use the
#     "Transaction" pooler, port 6543. This is REQUIRED on Vercel - the direct
#     or Session-pooler (port 5432) connection limit gets exhausted quickly
#     under serverless load.
#       DATABASE_URL=postgres://user:password@host.pooler.supabase.com:6543/postgres
#   - Local dev and the GitHub Actions tick script (scripts/tick.js): either
#     works, since these are single short-lived connections. Session pooler
#     (port 5432) shown below is fine here.
DATABASE_URL=postgres://user:password@host.pooler.supabase.com:5432/postgres

# Any password you want to log into the app with
APP_PASSWORD=changeme

# Random long random string, used to sign session cookies
SESSION_SECRET=change-this-to-something-random

# The ntfy.sh topic name you subscribed to in the ntfy iPhone app (pick something hard to guess)
NTFY_TOPIC=your-secret-topic-name-123

PORT=3000

# Set to "true" only if you're running this app standalone with no other
# tick source (i.e. NOT also using the GitHub Actions workflow). Leave unset
# otherwise - running both means two naggers hitting the same database.
ENABLE_LOCAL_SCHEDULER=false

# Optional: native Web Push (iOS 16.4+ installed PWAs, desktop Chrome/Firefox)
# alongside ntfy. Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave unset to skip Web Push entirely - ntfy keeps working either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Your deployed app's URL (no trailing slash). Required for the ntfy
# notification's "Done" / "Snooze 15m" action buttons to link back to a
# real, reachable server - set this on GitHub Actions too (it's what
# actually sends the notifications), not just Vercel/local.
PUBLIC_BASE_URL=https://your-app.vercel.app

# Optional: skip nagging during a window of hours (UTC, 0-23). Example
# below silences 10pm-8am UTC. Leave both unset to disable (nag any time).
# QUIET_HOURS_START=22
# QUIET_HOURS_END=8

# Optional: lets an external free cron service (e.g. cron-job.org) trigger
# GET /api/cron-tick?token=<this value> on your deployed URL every few
# minutes, for punctual nagging - GitHub Actions' own schedule trigger is
# best-effort and can run hours late. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable the endpoint entirely (it 403s with no token set).
CRON_TOKEN=
